{{#if mathjax_support}}
<!-- MathJax configuration: enable $...$ as inline math delimiter -->
<script type="text/x-mathjax-config">
MathJax.Hub.Config({
  tex2jax: {
    inlineMath: [['$','$'], ['\\(','\\)']],
    displayMath: [['$$','$$'], ['\\[','\\]']],
    processEscapes: true
  }
});
</script>
{{/if}}
