<mujoco>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>
        <light pos="0 0 3"/>
        <geom type="plane" size="1 1 0.5" rgba=".9 0 0 1"/>

        <body name="pendulum" pos="0 0 1">
            <joint name="hinge" type="hinge" axis="0 1 0"/>
            <geom type="capsule" size="0.03" fromto="0 0 0 0 0 -0.5" rgba="0.5 0.5 0.5 1"/>
            <geom type="sphere" size="0.08" pos="0 0 -0.5" rgba="0 1 0 1" mass="1"/>

            <!-- 末端 site：红色小球，可视化 + 可挂传感器 -->
            <site name="tip" pos="0 0 -0.5" size="0.04" rgba="1 0 0 1"/>
        </body>
    </worldbody>

    <sensor>
        <!-- 铰链关节角速度 (rad/s) -->
        <jointvel joint="hinge" name="hinge_vel"/>

        <!-- site 上挂传感器：末端的空间位置和速度 -->
        <framepos    objtype="site" objname="tip" name="tip_pos"/>
        <framelinvel objtype="site" objname="tip" name="tip_vel"/>
    </sensor>
</mujoco>
