<mujoco>
    <option timestep="0.001" integrator="RK4" gravity="0 0 -15"/>

    <default>
        <geom friction="1 0.1 0.1"/>
    </default>

    <visual>
        <headlight ambient="0.5 0.5 0.5" diffuse="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
        <global offwidth="1920" offheight="1080"/>
    </visual>

    <worldbody>
        <light diffuse="0.6 0.6 0.6" pos="0 0 6"  dir="0 0 -1"/>
        <light diffuse="0.4 0.4 0.4" pos="4  4 4"  dir="-1 -1 -1"/>
        <light diffuse="0.4 0.4 0.4" pos="-4 4 4"  dir="1 -1 -1"/>
        <light diffuse="0.4 0.4 0.4" pos="4 -4 4"  dir="-1 1 -1"/>
        <light diffuse="0.4 0.4 0.4" pos="-4 -4 4"  dir="1 1 -1"/>

        <geom type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1" friction="1.5 0.005 0.0001"/>

<!-- Target box on ground (bottom at z=0) -->
        <body name="target_box" pos="1.5 0 0.04">
            <freejoint/>
            <geom type="box" size="0.04 0.04 0.04" rgba="1.0 0.85 0.2 1" mass="0.05" friction="1.5 0.1 0.1"/>
        </body>

        <body name="car" pos="0 0 0.22">
            <freejoint/>

            <geom type="box" size="0.5 0.3 0.15" rgba="0.2 0.6 0.8 1" mass="10" contype="0" conaffinity="0"/>

            <!-- ========== 4-DOF Arm (2× scale, wide joint ranges) ========== -->
            <body name="arm_base" pos="0 0 0.22">
                <joint name="shoulder_pan" type="hinge" axis="0 0 1" range="-180 180" armature="0.10" damping="0.5"/>
                <geom type="cylinder" size="0.08 0.07" rgba="0.9 0.5 0.1 1" mass="0.35"/>

                <body name="upper_arm" pos="0 0 0.12">
                    <joint name="shoulder_lift" type="hinge" axis="0 1 0" range="-150 150" armature="0.10" damping="0.5"/>
                    <geom type="capsule" size="0.065" fromto="0 0 0 0 0 0.50" rgba="0.9 0.5 0.1 1" mass="0.40"/>

                    <body name="forearm" pos="0 0 0.50">
                        <joint name="elbow" type="hinge" axis="0 1 0" range="-150 150" armature="0.10" damping="0.5"/>
                        <geom type="capsule" size="0.055" fromto="0 0 0 0 0 0.40" rgba="0.9 0.5 0.1 1" mass="0.30"/>

                        <body name="wrist" pos="0 0 0.40">
                            <joint name="wrist_pitch" type="hinge" axis="0 1 0" range="-150 150" armature="0.06" damping="0.5"/>
                            <geom type="capsule" size="0.045" fromto="0 0 0 0 0 0.16" rgba="0.9 0.5 0.1 1" mass="0.15"/>

                            <body name="gripper" pos="0 0 0.16">
                                <joint name="gripper" type="slide" axis="1 0 0" range="-0.05 0.05" armature="0.02" damping="1.0"/>
                                <geom type="box" pos="0 0 0" size="0.08 0.08 0.08" rgba="0.3 0.3 0.3 1" mass="0.12"/>
                                <site name="end_effector" pos="0 0 0" size="0.025" rgba="1 0 0 1"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
            <!-- ========== /Arm ========== -->

            <body name="wheel_fl" pos="0.4 0.3 -0.1">
                <joint name="wheel_fl_joint" type="hinge" axis="0 1 0"/>
                <geom type="cylinder" size="0.12 0.05" euler="90 0 0" rgba="0.1 0.1 0.1 1" mass="1" friction="1.5 0.005 0.0001"/>
            </body>
            <body name="wheel_fr" pos="0.4 -0.3 -0.1">
                <joint name="wheel_fr_joint" type="hinge" axis="0 1 0"/>
                <geom type="cylinder" size="0.12 0.05" euler="90 0 0" rgba="0.1 0.1 0.1 1" mass="1" friction="1.5 0.005 0.0001"/>
            </body>
            <body name="wheel_rl" pos="-0.4 0.3 -0.1">
                <joint name="wheel_rl_joint" type="hinge" axis="0 1 0"/>
                <geom type="cylinder" size="0.12 0.05" euler="90 0 0" rgba="0.1 0.1 0.1 1" mass="1" friction="1.5 0.005 0.0001"/>
            </body>
            <body name="wheel_rr" pos="-0.4 -0.3 -0.1">
                <joint name="wheel_rr_joint" type="hinge" axis="0 1 0"/>
                <geom type="cylinder" size="0.12 0.05" euler="90 0 0" rgba="0.1 0.1 0.1 1" mass="1" friction="1.5 0.005 0.0001"/>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor joint="wheel_fl_joint" name="motor_wheel_fl" gear="3" ctrllimited="true" ctrlrange="-5 5"/>
        <motor joint="wheel_fr_joint" name="motor_wheel_fr" gear="3" ctrllimited="true" ctrlrange="-5 5"/>
        <motor joint="wheel_rl_joint" name="motor_wheel_rl" gear="3" ctrllimited="true" ctrlrange="-5 5"/>
        <motor joint="wheel_rr_joint" name="motor_wheel_rr" gear="3" ctrllimited="true" ctrlrange="-5 5"/>
        <position name="pservo_shoulder_pan"  joint="shoulder_pan"  kp="200" kv="10"/>
        <position name="pservo_shoulder_lift" joint="shoulder_lift" kp="200" kv="10"/>
        <position name="pservo_elbow"          joint="elbow"         kp="200" kv="10"/>
        <position name="pservo_wrist_pitch"    joint="wrist_pitch"   kp="120" kv="6"/>
        <position name="pservo_gripper"        joint="gripper"       kp="300" kv="15"/>
    </actuator>

    <equality>
        <weld name="grasp_weld" body1="gripper" body2="target_box"
              active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    </equality>
</mujoco>
